{
  "name": "webworkerjoshua/composer-check-updates",
  "description": "Interactive dependency update checker for Composer — shows updates within and beyond your version ranges, npm-check-updates style",
  "type": "composer-plugin",
  "license": "MIT",
  "bin": [
    "bin/ccu"
  ],
  "keywords": [
    "composer",
    "update",
    "outdated",
    "dependencies",
    "interactive",
    "ncu"
  ],
  "require": {
    "php": ">=8.3",
    "composer-plugin-api": "^2.3"
  },
  "require-dev": {
    "composer/composer": "^2.7",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "ComposerCheckUpdates\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ComposerCheckUpdates\\Tests\\": "tests/"
    }
  },
  "extra": {
    "class": "ComposerCheckUpdates\\Plugin"
  },
  "scripts": {
    "test": "pest",
    "stan": "phpstan analyse --memory-limit=1G",
    "check": [
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
